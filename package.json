{
  "name": "gwc-revamp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "lint:check": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:strict": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "type-check": "tsc --noEmit",
    "validate": "npm run type-check && npm run lint:check",
    "setup": "node setup-env.js",
    "prepare": "husky",
    "prodDeploy": "npm run build && node deploy.js"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,md,mdx,css,html,yaml,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@supabase/supabase-js": "^2.98.0",
    "basic-ftp": "^5.2.0",
    "chalk": "^5.6.2",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "cli-progress": "^3.12.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "fast-glob": "^3.3.3",
    "formik": "^2.4.9",
    "framer-motion": "^12.23.24",
    "gsap": "^3.13.0",
    "locomotive-scroll": "^4.1.4",
    "lucide-react": "^0.562.0",
    "motion": "^12.23.24",
    "next": "^16.0.1",
    "next-seo": "^6.8.0",
    "next-sitemap": "^4.2.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "react-intersection-observer": "^10.0.0",
    "react-toastify": "^11.0.5",
    "split-type": "^0.3.4",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.181.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "autoprefixer": "^10.4.21",
    "babel-jest": "^30.2.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.33",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unused-imports": "^4.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.18"
  }
}
